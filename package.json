{
  "name": "classroom-resources",
  "version": "1.0.0",
  "description": "A public, static catalogue of classroom web resources designed for a teacher in Malta.",
  "main": "app.js",
  "scripts": {
    "build": "node build.mjs",
    "build:site": "node build.mjs --site",
    "test": "node --test tests/model.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-classroom --only firestore \"node --test tests/rules.test.mjs\"",
    "test:ui": "node tests/ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Species84720/classroom-resources.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Species84720/classroom-resources/issues"
  },
  "homepage": "https://github.com/Species84720/classroom-resources#readme",
  "dependencies": {
    "firebase": "^12.3.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.1",
    "esbuild": "^0.25.10",
    "firebase-tools": "^14.17.0"
  },
  "private": true,
  "overrides": {
    "image-size": "2.0.4"
  }
}

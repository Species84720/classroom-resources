rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function owner() { return googleUser() && resource.data.ownerId == request.auth.uid; }
    function valid() {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerId','title','description','year_group','subject','published','content','version','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerId','title','description','year_group','subject','published','content','version','createdAt','updatedAt'])
        && d.ownerId == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 600
        && d.year_group is string && d.year_group.size() > 0 && d.year_group.size() <= 40
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 60
        && d.published is bool && d.content is string && d.content.size() > 0 && d.content.size() <= 700000
        && d.version is int && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /presentations/{id} {
      allow get: if (googleUser() && !exists(/databases/$(database)/documents/presentations/$(id)))
        || resource.data.published == true || owner();
      allow list: if resource.data.published == true || owner();
      allow create: if googleUser() && valid() && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if owner();
    }
  }
}
